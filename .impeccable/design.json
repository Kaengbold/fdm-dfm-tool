  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The step's one next move, right of the panel foot.",
      "html": "<button class=\"ds-btn-primary\">Next: Will it hold?</button>",
      "css": ".ds-btn-primary{font:700 14px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif;background:var(--accent,#1f5c47);border:1px solid var(--accent,#1f5c47);color:#fff;padding:9px 16px;border-radius:6px;cursor:pointer;transition:border-color .12s,background-color .12s}.ds-btn-primary:hover{background:var(--accent-hover,#174a39)}.ds-btn-primary:focus-visible{outline:3px solid var(--now,#f2c12e);outline-offset:2px}.ds-btn-primary:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Back, sample picks, list actions.",
      "html": "<button class=\"ds-btn\">Back</button>",
      "css": ".ds-btn{font:400 14px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif;color:var(--text,#1d2b27);background:var(--panel,#fdfdfc);border:1px solid var(--line-strong,#c3cdc6);border-radius:6px;padding:6px 12px;cursor:pointer;transition:border-color .12s,background-color .12s}.ds-btn:hover{border-color:var(--accent,#1f5c47)}.ds-btn:focus-visible{outline:3px solid var(--now,#f2c12e);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-priority actions such as Cancel.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn-ghost{font:400 14px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif;background:none;border:1px solid var(--line,#dbe2dd);color:var(--muted,#56645f);border-radius:6px;padding:6px 12px;cursor:pointer}.ds-btn-ghost:hover{color:var(--text,#1d2b27);border-color:var(--accent,#1f5c47)}.ds-btn-ghost:focus-visible{outline:3px solid var(--now,#f2c12e);outline-offset:2px}"
    },
    {
      "name": "Level Switch",
      "kind": "nav",
      "refersTo": "segment-selected",
      "description": "Simple / Basic / Advanced / Expert segmented radio group in the header.",
      "html": "<div class=\"ds-levels\"><label><input type=\"radio\" name=\"ds-l\" checked>Simple</label><label><input type=\"radio\" name=\"ds-l\">Basic</label><label><input type=\"radio\" name=\"ds-l\">Advanced</label><label><input type=\"radio\" name=\"ds-l\">Expert</label></div>",
      "css": ".ds-levels{display:inline-flex;padding:3px;gap:2px;background:#e3e9e4;border-radius:9px;font:14px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif}.ds-levels label{position:relative;cursor:pointer;border-radius:6px;padding:5px 13px;color:var(--muted,#56645f)}.ds-levels label:hover{color:var(--text,#1d2b27)}.ds-levels input{position:absolute;opacity:0}.ds-levels label:has(input:checked){background:var(--accent,#1f5c47);color:#fff;font-weight:700}.ds-levels label:has(input:focus-visible){outline:3px solid var(--now,#f2c12e);outline-offset:1px}"
    },
    {
      "name": "Step Rail",
      "kind": "nav",
      "refersTo": "step-now",
      "description": "Checklist of steps: done, current, upcoming, locked.",
      "html": "<nav class=\"ds-steps\"><button class=\"ds-step done\"><span class=\"dot\"><svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>Your part</button><button class=\"ds-step now\"><span class=\"dot\">2</span>Problems</button><button class=\"ds-step\"><span class=\"dot\">3</span>Will it hold?</button><button class=\"ds-step locked\" disabled><span class=\"dot\">4</span>Download</button></nav>",
      "css": ".ds-steps{display:flex;flex-direction:column;gap:2px;padding:16px 10px;background:var(--chrome,#f3f5f2);width:210px}.ds-step{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border:0;border-radius:6px;background:none;text-align:left;font:15px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif;color:var(--text,#1d2b27);cursor:pointer}.ds-step:hover:not(:disabled):not(.now){background:#e6ebe7}.ds-step:focus-visible{outline:3px solid var(--now,#f2c12e);outline-offset:2px}.ds-step .dot{flex:none;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-size:13px;font-weight:700;background:#e1e7e2;color:var(--muted,#56645f)}.ds-step.now{background:var(--accent-soft,#e2efe8);font-weight:700}.ds-step.now .dot{background:var(--now,#f2c12e);color:var(--text,#1d2b27)}.ds-step.done .dot{background:var(--good,#22784a);color:#fff}.ds-step.locked{color:var(--muted,#56645f);cursor:default}.ds-step.locked .dot{background:none;border:1.5px dashed var(--line-strong,#c3cdc6)}"
    },
    {
      "name": "Select Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label stacked over a select or input.",
      "html": "<label class=\"ds-field\">Material<select><option>PLA</option><option>PETG</option></select></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:5px;font:700 14px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif;color:var(--text,#1d2b27);width:200px}.ds-field select{font:400 14px 'Atkinson Hyperlegible',system-ui,sans-serif;color:var(--text,#1d2b27);background:var(--panel,#fdfdfc);border:1px solid var(--line-strong,#c3cdc6);border-radius:6px;padding:5px 7px}.ds-field select:hover{border-color:var(--muted,#56645f)}.ds-field select:focus-visible{outline:3px solid var(--now,#f2c12e);outline-offset:2px}"
    },
    {
      "name": "Finding Card",
      "kind": "card",
      "refersTo": "finding-card",
      "description": "One problem: chevron, title, severity badge, one-line gist, fix chip.",
      "html": "<div class=\"ds-finding\" tabindex=\"0\"><div class=\"ds-f-head\"><b>Small hole prints undersized</b><span class=\"ds-sev\">Warning</span></div><p class=\"ds-gist\">The CAD model has an exact diameter hole for a bolt.</p><span class=\"ds-chip\">Fix: a slicer setting</span></div>",
      "css": ".ds-finding{font:14px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif;color:var(--text,#1d2b27);border:1px solid var(--line,#dbe2dd);border-radius:6px;padding:9px 11px;background:var(--panel,#fdfdfc);display:flex;flex-direction:column;gap:4px;max-width:360px;cursor:pointer}.ds-finding:hover{border-color:var(--line-strong,#c3cdc6)}.ds-finding:focus-visible{outline:3px solid var(--now,#f2c12e);outline-offset:2px}.ds-f-head{display:flex;gap:8px;align-items:baseline;justify-content:space-between}.ds-f-head b::before{content:'';display:inline-block;width:6px;height:6px;margin:0 9px 2px 1px;border:solid var(--accent,#1f5c47);border-width:0 2px 2px 0;transform:rotate(-45deg)}.ds-sev{font-size:12px;font-weight:700;padding:1px 7px;border-radius:999px;background:var(--warn-soft,#fbf0d9);color:var(--warn,#8f5600)}.ds-gist{margin:0;color:var(--muted,#56645f);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-chip{align-self:flex-start;font-size:12px;font-weight:700;border-radius:999px;padding:1px 8px;background:var(--accent-soft,#e2efe8);color:var(--accent,#1f5c47)}"
    },
    {
      "name": "Verdict Box",
      "kind": "card",
      "refersTo": "",
      "description": "Result statement on a soft meaning fill.",
      "html": "<div class=\"ds-verdict\"><strong>Prints as designed</strong><span>Turned the best way. 10 slicer settings for PLA on your Bambu Lab P1S.</span></div>",
      "css": ".ds-verdict{display:flex;flex-direction:column;gap:3px;padding:13px 14px;border-radius:6px;background:var(--good-soft,#e1f2e8);font:14px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif;color:var(--text,#1d2b27);max-width:360px}.ds-verdict strong{font-size:19px;color:var(--good,#22784a)}"
    },
    {
      "name": "Working Bar",
      "kind": "custom",
      "refersTo": "working-bar",
      "description": "Floats over the 3D stage while the engine runs: what, how long, cancel, progress, what it updates.",
      "html": "<div class=\"ds-working\"><div class=\"ds-wh\"><span class=\"ds-spin\"></span><b>Checking strength</b><span class=\"ds-time\">0:12</span><button class=\"ds-wbtn\">Cancel</button></div><div class=\"ds-prog\"><i></i></div><p class=\"ds-aff\">Will update: Will it hold?</p></div>",
      "css": ".ds-working{width:480px;padding:11px 14px;border-radius:10px;background:#173a2e;color:#f3f5f2;box-shadow:0 8px 24px #10241c40;font:15px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif}.ds-wh{display:flex;align-items:center;gap:10px}.ds-wh b{flex:1}.ds-time{color:#b9c9c1;font-size:13px;font-variant-numeric:tabular-nums}.ds-spin{width:15px;height:15px;border-radius:50%;border:3px solid #ffffff33;border-top-color:#f2c12e;animation:ds-spin .8s linear infinite}@keyframes ds-spin{to{transform:rotate(360deg)}}.ds-wbtn{font:14px 'Atkinson Hyperlegible',system-ui,sans-serif;background:none;color:#f3f5f2;border:1px solid #f3f5f259;border-radius:6px;padding:6px 12px;cursor:pointer}.ds-wbtn:hover{border-color:#f3f5f2;background:#ffffff14}.ds-wbtn:focus-visible{outline:3px solid #f2c12e;outline-offset:2px}.ds-prog{margin-top:9px;height:5px;border-radius:3px;background:#ffffff26;overflow:hidden}.ds-prog i{display:block;width:40%;height:100%;background:#f2c12e}.ds-aff{margin:7px 0 0;font-size:13px;color:#f6d77a}"
    },
    {
      "name": "Drop Zone",
      "kind": "custom",
      "refersTo": "",
      "description": "Where a part file is dropped or picked.",
      "html": "<div class=\"ds-drop\" tabindex=\"0\"><strong>Drop an STL, 3MF or STEP file here</strong><span>or click to choose one. It stays on your computer.</span></div>",
      "css": ".ds-drop{display:flex;flex-direction:column;gap:4px;align-items:center;text-align:center;padding:34px 14px;border:2px dashed var(--line-strong,#c3cdc6);border-radius:10px;background:var(--soft,#eef2ef);color:var(--muted,#56645f);cursor:pointer;font:15px/1.45 'Atkinson Hyperlegible',system-ui,sans-serif;max-width:360px}.ds-drop strong{color:var(--text,#1d2b27);font-size:16px}.ds-drop:hover{border-color:var(--accent,#1f5c47);background:var(--accent-soft,#e2efe8)}.ds-drop:focus-visible{outline:3px solid var(--now,#f2c12e);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Workbench",
    "overview": "FDM Check is a bench, not a form. Three fixed zones sit side by side at full viewport height: a pale step rail that reads like a checklist, the part itself large in the middle on a calm grey stage, and a near-white panel on the right holding only the current step's controls, with one primary action pinned at its foot. Nothing scrolls the whole page on desktop; the part never leaves view.\n\nThe world is light and quiet: near-white surfaces with a faint green cast, dark-green ink and actions, hairline borders, small 6px corners, no gradients. One loud colour exists, a signal yellow, and it means exactly two things: \"you are here\" (the current step's dot) and keyboard focus. Every other colour is either green ink or a meaning colour (good, warn, bad) or a colour painted on the part in the 3D view. Atkinson Hyperlegible carries everything at modest sizes; hierarchy comes from weight, not scale.\n\nDensity is calm but working: 14px controls, 13px hints, 14px vertical rhythm inside a pane. Detail lives behind closed disclosures (\"More information\", \"Which nozzle?\"), so the panel stays short.",
    "keyCharacteristics": [
      "Three-zone grid (step rail, 3D stage, step panel) with a 56px header.",
      "Faint-green near-white surfaces, dark-green ink and buttons.",
      "Signal yellow reserved for \"you are here\" and focus.",
      "One primary button per step, at the panel foot.",
      "Hairline borders and 6px corners; shadows only on things floating over the 3D stage.",
      "Background work shown in a dark-green bar over the stage, never in the panel."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Signal Yellow means \"you are here\" or \"keyboard focus\" (plus progress inside the working bar). It is never a decoration, a heading colour or a warning colour; warnings use Warn.",
        "section": "colors"
      },
      {
        "name": "The Part Palette Stays on the Part Rule",
        "body": "The saturated part colours belong to the 3D view and its keys. They never fill buttons, panels or headings.",
        "section": "colors"
      },
      {
        "name": "The Read From CSS Rule",
        "body": "Any colour the 3D view paints is a CSS custom property read at runtime. No colour is defined twice.",
        "section": "colors"
      },
      {
        "name": "The Weight Not Size Rule",
        "body": "The ramp tops out at 23px. Emphasis is 700 weight or a meaning colour, never a bigger size.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Headings, labels, buttons and badges are written in sentence case. No uppercase labels, no letter-spaced small caps.",
        "section": "typography"
      },
      {
        "name": "The Float Only Rule",
        "body": "A shadow means \"this hovers over something\". Cards, buttons and inputs in the panel never carry one.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the three zones; a new step adds a pane to the panel and a row to the rail, not a new page.",
      "Do give each step one primary button, at the right of the panel foot, phrased as the next move.",
      "Do use Signal Yellow (#f2c12e) only for the current step, focus and progress.",
      "Do say what a change updates, in a 13px muted line under the control or in the working bar.",
      "Do put detail in closed disclosures with a bold green summary.",
      "Do read every 3D colour from a CSS custom property.",
      "Do use soft meaning fills (good, warn, bad) for verdicts and badges, with the strong colour on the text."
    ],
    "donts": [
      "Don't add gradients, a cutting-mat texture, or any pattern behind the 3D view; the stage stays a flat calm grey.",
      "Don't put shadows on panel cards, buttons or inputs; shadows are for things floating over the stage or page.",
      "Don't use the part colours (support red, droop amber, force violet…) as UI fills or text colours outside keys and swatches.",
      "Don't raise headings above 23px or add a second typeface.",
      "Don't add uppercase or letter-spaced labels above headings.",
      "Don't show background work only in the panel; it belongs in the working bar over the stage."
    ]
  }
}